# =============================================================
# NG TRAVELS ERP - ENVIRONMENT CONFIGURATION TEMPLATE
# One shared .env file for both the frontend (artifacts/ng-travels)
# and the backend (artifacts/api-server). Copy this to .env and fill
# in the values. On Vercel, set the same keys once in Project Settings
# > Environment Variables — the static build and the /api serverless
# function both read from that single project configuration.
# =============================================================

# Node Environment (development | production)
NODE_ENV=development

# --- Backend (api-server) ---

# Server Port
PORT=5000

# Database — Supabase Postgres Connection String
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=

# Server-Only Supabase URL (used to verify Supabase Auth tokens and call the admin API)
SUPABASE_URL=

# Server-Only Supabase Key (Never expose to client or prefix with NEXT_PUBLIC/VITE)
SUPABASE_SERVICE_ROLE_KEY=

# Geocoding, Places Autocomplete & Routing API Key (Geoapify or Google Maps) — used by both apps
GEOAPIFY_API_KEY=

# --- Frontend (ng-travels, Vite — only VITE_ / NEXT_PUBLIC_ prefixed keys reach the browser bundle) ---

# Backend endpoint used ONLY by the packaged Capacitor Owner/Driver APKs and when
# testing a native app role locally. The web app itself calls same-origin "/api".
VITE_API_URL=http://localhost:5000

# Supabase (client-side)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web Base Path
BASE_URL=/

# Secret Vercel Cron sends to /api/cron/* (any long random string)
CRON_SECRET=
